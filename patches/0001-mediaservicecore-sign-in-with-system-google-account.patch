@@ -21,6 +21,17 @@ public class AccessToken extends ErrorResponse {
     @JsonPath("$.token_type")
     private String mTokenType;
 
+    /**
+     * Build a token that did not come from the OAuth2 JSON API (e.g. issued by the system account manager).
+     */
+    public static AccessToken create(String accessToken, String tokenType, int expiresIn) {
+        AccessToken token = new AccessToken();
+        token.mAccessToken = accessToken;
+        token.mTokenType = tokenType;
