+++ b/youtubeapi/src/main/java/com/liskovsoft/youtubeapi/service/internal/YouTubeAccountManager.java
@@ -105,6 +105,22 @@ public class YouTubeAccountManager {
         });
     }
 
+    /**
+     * Sign in with a Google account from the system account manager (Google Play Services or microG).<br/>
+     * Blocking: call from a background thread.
+     *
+     * @throws IllegalStateException when the account can't be used
+     */
+    public void signInWithGmsAccount(String accountName) {
+        String key = GmsAccountAuth.toKey(accountName);
+
+        persistRefreshToken(key);
+
+        if (findAccountByToken(key) == null) {
+            throw new IllegalStateException("Sign in failed: the account could not be used");
+        }
+    }
+
     @Nullable
     public List<Account> getAccounts() {
         return mAccounts;
