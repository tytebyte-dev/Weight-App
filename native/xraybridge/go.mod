module github.com/tytebyte-dev/weight-app/native/xraybridge

go 1.26

// The Xray-core sources shipped with the app (native/xray-core, v26.3.27).
// go.sum is generated by native/build-cores.sh (`go mod tidy`) because the
// dependency set depends on the build network, so it is not committed.
require github.com/xtls/xray-core v0.0.0

replace github.com/xtls/xray-core => ../xray-core
