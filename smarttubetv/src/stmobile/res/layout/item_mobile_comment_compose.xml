<?xml version="1.0" encoding="utf-8"?>
<!--
  NEWTUBE(write-comments): the "Add a comment…" row at the top of the comments list (and "Add a
  reply…" under a replies page's comment). The signed-in person's avatar where a comment's is, and
  a pill that opens the composer (CommentComposer); signed out, the tap asks to sign in.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/comment_compose_avatar"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_watch_channel_placeholder" />

    <TextView
        android:id="@+id/comment_compose_field"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:background="@drawable/bg_comment_compose_field"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/mobile_comments_add_hint"
        android:textColor="@color/mobile_color_on_surface_secondary"
        android:textSize="14sp" />

</LinearLayout>
