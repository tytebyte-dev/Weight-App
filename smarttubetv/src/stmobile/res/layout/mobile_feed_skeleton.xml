<?xml version="1.0" encoding="utf-8"?>
<!-- Shimmering (ShimmerLinearLayout) loading skeleton for the feed grids. Mirrors
     item_video_card's geometry (16:9-ish thumb + title + meta line) so the real cards
     replace it without a jarring layout shift. Shown only while a section loads into an
     EMPTY grid - never over content (returning to already-loaded content stays instant).
     NEWTUBE(feed-avatars): the avatar circles (tag "avatar") show where the cards have one, on
     Home and Subscriptions (MobileBrowseActivity.setSkeletonAvatars). -->
<com.newtube.mobile.ui.common.ShimmerLinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_feed_skeleton"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/mobile_card_spacing"
    android:paddingTop="@dimen/mobile_card_spacing"
    tools:visibility="visible">

    <LinearLayout
        android:id="@+id/skel_cards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <LinearLayout style="@style/MobileSkeletonFeedCard">
        <View style="@style/MobileSkeletonFeedThumb" />
        <LinearLayout style="@style/MobileSkeletonFeedTextRow">
            <View style="@style/MobileSkeletonFeedAvatar" />
            <LinearLayout style="@style/MobileSkeletonFeedText">
                <View style="@style/MobileSkeletonFeedLineWide" />
                <View style="@style/MobileSkeletonFeedLineNarrow" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout style="@style/MobileSkeletonFeedCard">
        <View style="@style/MobileSkeletonFeedThumb" />
        <LinearLayout style="@style/MobileSkeletonFeedTextRow">
            <View style="@style/MobileSkeletonFeedAvatar" />
            <LinearLayout style="@style/MobileSkeletonFeedText">
                <View style="@style/MobileSkeletonFeedLineWide" />
                <View style="@style/MobileSkeletonFeedLineNarrow" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout style="@style/MobileSkeletonFeedCard">
        <View style="@style/MobileSkeletonFeedThumb" />
        <LinearLayout style="@style/MobileSkeletonFeedTextRow">
            <View style="@style/MobileSkeletonFeedAvatar" />
            <LinearLayout style="@style/MobileSkeletonFeedText">
                <View style="@style/MobileSkeletonFeedLineWide" />
                <View style="@style/MobileSkeletonFeedLineNarrow" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    </LinearLayout>

    <!-- Music tab: ghost header (only when the real one is not on screen) + song rows. -->
    <LinearLayout
        android:id="@+id/skel_music"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/skel_music_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">
            <View
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_skeleton_block" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <View style="@style/MobileSkeletonMusicChip" />
                <View style="@style/MobileSkeletonMusicChip" />
                <View style="@style/MobileSkeletonMusicChip" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout style="@style/MobileSkeletonMusicRow">
            <View style="@style/MobileSkeletonMusicArt" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <View style="@style/MobileSkeletonMusicLineWide" />
                <View style="@style/MobileSkeletonMusicLineNarrow" />
            </LinearLayout>
            <View style="@style/MobileSkeletonMusicTail" />
        </LinearLayout>
        <LinearLayout style="@style/MobileSkeletonMusicRow">
            <View style="@style/MobileSkeletonMusicArt" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <View style="@style/MobileSkeletonMusicLineWide" />
                <View style="@style/MobileSkeletonMusicLineNarrow" />
            </LinearLayout>
            <View style="@style/MobileSkeletonMusicTail" />
        </LinearLayout>
        <LinearLayout style="@style/MobileSkeletonMusicRow">
            <View style="@style/MobileSkeletonMusicArt" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <View style="@style/MobileSkeletonMusicLineWide" />
                <View style="@style/MobileSkeletonMusicLineNarrow" />
            </LinearLayout>
            <View style="@style/MobileSkeletonMusicTail" />
        </LinearLayout>
        <LinearLayout style="@style/MobileSkeletonMusicRow">
            <View style="@style/MobileSkeletonMusicArt" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <View style="@style/MobileSkeletonMusicLineWide" />
                <View style="@style/MobileSkeletonMusicLineNarrow" />
            </LinearLayout>
            <View style="@style/MobileSkeletonMusicTail" />
        </LinearLayout>
        <LinearLayout style="@style/MobileSkeletonMusicRow">
            <View style="@style/MobileSkeletonMusicArt" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <View style="@style/MobileSkeletonMusicLineWide" />
                <View style="@style/MobileSkeletonMusicLineNarrow" />
            </LinearLayout>
            <View style="@style/MobileSkeletonMusicTail" />
        </LinearLayout>
        <LinearLayout style="@style/MobileSkeletonMusicRow">
            <View style="@style/MobileSkeletonMusicArt" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <View style="@style/MobileSkeletonMusicLineWide" />
                <View style="@style/MobileSkeletonMusicLineNarrow" />
            </LinearLayout>
            <View style="@style/MobileSkeletonMusicTail" />
        </LinearLayout>
        <LinearLayout style="@style/MobileSkeletonMusicRow">
            <View style="@style/MobileSkeletonMusicArt" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <View style="@style/MobileSkeletonMusicLineWide" />
                <View style="@style/MobileSkeletonMusicLineNarrow" />
            </LinearLayout>
            <View style="@style/MobileSkeletonMusicTail" />
        </LinearLayout>
        <LinearLayout style="@style/MobileSkeletonMusicRow">
            <View style="@style/MobileSkeletonMusicArt" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <View style="@style/MobileSkeletonMusicLineWide" />
                <View style="@style/MobileSkeletonMusicLineNarrow" />
            </LinearLayout>
            <View style="@style/MobileSkeletonMusicTail" />
        </LinearLayout>
        <LinearLayout style="@style/MobileSkeletonMusicRow">
            <View style="@style/MobileSkeletonMusicArt" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <View style="@style/MobileSkeletonMusicLineWide" />
                <View style="@style/MobileSkeletonMusicLineNarrow" />
            </LinearLayout>
            <View style="@style/MobileSkeletonMusicTail" />
        </LinearLayout>
    </LinearLayout>

</com.newtube.mobile.ui.common.ShimmerLinearLayout>
